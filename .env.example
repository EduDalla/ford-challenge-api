# Credenciais do MySQL usadas pelo docker-compose.
# Se o volume do banco ja existir, estes valores precisam bater com o estado real do banco.
MYSQL_DATABASE=pulso_retencao
MYSQL_APP_USER=pulso
MYSQL_APP_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Segredo usado para assinar e validar JWT do backend Java.
JWT_SECRET=troque-este-segredo

# Portas e timezone do ambiente local.
MYSQL_HOST_PORT=3307
APP_PORT=8080
TZ=America/Sao_Paulo
