# Credenciais do PostgreSQL usadas pelo docker-compose.
# Se o volume do banco ja existir, estes valores precisam bater com o estado real do banco.
POSTGRES_DB=pulso_retencao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha

# Segredo usado para assinar e validar JWT do backend Java.
JWT_SECRET=troque-este-segredo

# Origens autorizadas para front/mobile. Em prod, nao use wildcard (*).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:5173

# Supabase Auth/JWT. JWKS e o caminho preferencial; JWT secret e fallback legacy.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=

# Integracao com a FastAPI de ML.
FORD_ML_BASE_URL=https://ford-vinguard-api.onrender.com
FORD_ML_SERVICE_TOKEN=
FORD_ML_TIMEOUT_MS=8000
FORD_ML_MODEL_VERSION=churn_pos_venda_rf_calibrated

# Demo token opcional para testes manuais controlados.
DEMO_MODE=false
JAVA_ML_DEMO_TOKEN=

# Jobs do pipeline ML.
APP_JOBS_REFRESH_FEATURE_SNAPSHOTS_ENABLED=true
APP_JOBS_REFRESH_FEATURE_SNAPSHOTS_CRON="0 */30 * * * *"
APP_JOBS_REFRESH_FEATURE_SNAPSHOTS_BATCH_SIZE=100
APP_JOBS_PROCESSAR_PREDICOES_ML_ENABLED=true
APP_JOBS_PROCESSAR_PREDICOES_ML_CRON="0 0 23 * * SUN"
APP_JOBS_PROCESSAR_PREDICOES_ML_BATCH_SIZE=100
APP_JOBS_PROCESSAR_PREDICOES_ML_MAX_ATTEMPTS=3
APP_JOBS_PROCESSAR_PREDICOES_ML_RETRY_DELAY_MINUTES=60

# Portas e timezone do ambiente local.
POSTGRES_HOST_PORT=5433
APP_PORT=8080
TZ=America/Sao_Paulo
