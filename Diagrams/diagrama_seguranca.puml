@startuml diagrama_seguranca
!theme plain
skinparam backgroundColor #F8F9FA
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #DBEAFE
    BorderColor #2563EB
    FontColor #1E3A5F
}

skinparam actor {
    BackgroundColor #EDE9FE
    BorderColor #7C3AED
}

skinparam database {
    BackgroundColor #D1FAE5
    BorderColor #059669
}

title **Pulso de Retenção — Fluxo de Segurança**\n<size:11>(Autenticação · Autorização · Rate Limiting)</size>

actor "Consultor\n(Mobile App)" as user
participant "**RateLimitFilter**\n(ConcurrentHashMap\nSliding Window)" as rl
participant "**SecurityFilter**\n(OncePerRequestFilter)" as sf
participant "**TokenService**\n(JWT HS256 +\nSupabase RS256)" as ts
database "**PostgreSQL**\n(API Clients\n+ Usuários)" as db
participant "**Supabase Auth**\n(JWKS endpoint)" as jwks
participant "**Controller**\n(+ @Valid)" as ctrl
participant "**GlobalException\nHandler**" as geh

== Fluxo Normal — Request Autenticado ==

user -> rl : HTTP Request\n(Authorization: Bearer <token>)

rl -> rl : resolve IP\n(X-Forwarded-For)
rl -> rl : sliding window check\n(60 req/min geral\n10 req/min /auth)

alt IP dentro do limite
    rl -> sf : chain.doFilter()
else limite excedido
    rl --> user : **HTTP 429**\nToo Many Requests\n(ErrorResponse JSON)
end

sf -> sf : extrai token do header\nAuthorization: Bearer

alt Token Supabase (RS256)
    sf -> jwks : GET /.well-known/jwks.json
    jwks --> sf : chave pública RSA
    sf -> sf : valida assinatura RS256\n+ issuer + audience
else Token Interno (HS256)
    sf -> sf : valida com JWT_SECRET\n(TokenService.validarToken)
    sf -> db : busca usuário / API Client\npor subject do JWT
    db --> sf : dados do perfil + roles
end

alt Token inválido ou expirado
    sf --> user : **HTTP 401** Unauthorized
else Token válido
    sf -> sf : popula SecurityContext\n(Authentication + authorities)
end

sf -> ctrl : request com contexto\nde autenticação

ctrl -> ctrl : @Valid valida\nRequestBody\n(Bean Validation)

alt Payload inválido
    ctrl --> geh : MethodArgumentNotValidException
    geh --> user : **HTTP 400** Bad Request\n(ErrorResponse com campos)
else Payload válido
    ctrl -> ctrl : verifica autorização\n(@PreAuthorize / hasRole)

    alt Sem permissão
        ctrl --> user : **HTTP 403** Forbidden
    else Autorizado
        ctrl --> user : **HTTP 200/201**\nResposta de negócio
    end
end

== Fluxo Especial — Endpoint ML ==

user -> rl : POST /api/v1/ml/predict\n(Bearer token)
rl -> sf : dentro do limite
sf -> ctrl : AuthorizationDecision\npodeAcessarMl()

note over ctrl
  Acesso ML liberado se:
  1. ROLE_ADMIN / ROLE_GESTOR / ROLE_ANALISTA
  2. SCOPE_ml:predict (service token)
  3. Header X-ML-Demo-Token válido\n   (apenas se DEMO_MODE=true)
end note

== Fluxo — Obtenção de Service Token ==

user -> rl : POST /api/v1/auth/service-token\n{clientId, clientSecret}
rl -> rl : sliding window check\n(**10 req/min** para /auth)
rl -> sf : dentro do limite
sf -> ctrl : endpoint público\n(sem auth necessária)
ctrl -> db : busca API Client por clientId
db --> ctrl : API Client + BCrypt hash

alt Credenciais inválidas
    ctrl -> ctrl : AuthenticationRateLimiter\n+1 falha para IP+client
    note over ctrl : Bloqueio após 5 falhas/10min
    ctrl --> user : **HTTP 401**
else Credenciais válidas
    ctrl -> ctrl : BCrypt.matches(secret, hash)
    ctrl -> ts : gera JWT HS256\ncom roles/scopes do client
    ts --> ctrl : token assinado (expira em 1h)
    ctrl --> user : **HTTP 200**\n{token: "eyJ..."}
end

@enduml
